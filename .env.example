# ──────────────────────────────────────────────
# LeadsBoard Frontend — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and adjust values.
#   cp .env.example .env

# Base URL of the LeadsBoard backend API (no trailing slash)
VITE_API_BASE_URL=http://localhost:8000

# Application display name
VITE_APP_NAME=LeadsBoard
